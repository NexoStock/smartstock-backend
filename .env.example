# NEXOSTOCK - VARIABLES DE ENTORNO

# Perfil de desarrollo
SPRING_PROFILES_ACTIVE=local

# MySQL
DATABASE_URL=localhost
DATABASE_PORT=3306
DATABASE_NAME=nexostock
DATABASE_USER=root
DATABASE_PASSWORD=

# Seguridad JWT
# Configurar individualmente cuando se integre IAM
